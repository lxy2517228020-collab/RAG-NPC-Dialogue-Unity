  m_Script: {fileID: 11500000, guid: f4d6e0ae85cab4616b7f87607be9f289, type: 3}
  m_Name: Roland_NormalConversation 2
  m_EditorClassIdentifier: Assembly-CSharp::RAGNPCDialogue.DialogueSet
  npcName: Roland
  scenario: Does Roland help the rebels at night?
  dialogueCategory: 1
  dialogueLines:
  - speaker: Roland
    text: I close my forge at sunset. What happens after dark is none of your concern.
    emotionOrTag: stern
  - speaker: Roland
    text: Whispering about rebels in Greenhaven is a quick way to meet the Royal
      Guard.
    emotionOrTag: cautious
  - speaker: Roland
    text: If you need steel repaired, come back tomorrow. Otherwise, keep moving.
    emotionOrTag: neutral
